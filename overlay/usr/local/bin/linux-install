#!/bin/busybox sh
# ============================================================
#  linux-install  -  instala/atualiza o sistema no disco interno
#  (particao UNICA FAT32 + persistencia em arquivo-loop)
#
#  Uso:  linux-install [device]     (padrao: /dev/mmcblk0)
#
#  Deve rodar do sistema LIVE (pendrive). Copia o bootloader, o
#  kernel, o initrd e o rootfs.squashfs para a particao do eMMC
#  e garante a persistencia (persist.ext4).
# ============================================================
set -e
EMMC="${1:-/dev/mmcblk0}"
case "$EMMC" in
    *mmcblk*|*nvme*) P1="${EMMC}p1" ;;
    *)               P1="${EMMC}1" ;;
esac
SRC=/mnt/bootmedia
MNT=/mnt/emmc

echo ">> instalando em $P1  (origem: $SRC)"
mkdir -p "$MNT"
mount "$P1" "$MNT" 2>/dev/null || mount -t vfat "$P1" "$MNT"

mkdir -p "$MNT/EFI/BOOT" "$MNT/boot/grub" "$MNT/linux"

echo ">> bootloader / kernel / initrd"
cp -f "$SRC/EFI/BOOT/BOOTX64.EFI" "$MNT/EFI/BOOT/BOOTX64.EFI"
cp -f "$SRC/boot/vmlinuz"    "$MNT/boot/vmlinuz"
cp -f "$SRC/boot/initrd.img" "$MNT/boot/initrd.img"

echo ">> sistema (rootfs.squashfs)"
cp -f "$SRC/linux/rootfs.squashfs" "$MNT/linux/rootfs.squashfs"

echo ">> grub.cfg"
UUID="$(blkid "$P1" | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')"
cat > "$MNT/boot/grub/grub.cfg" <<EOF
set default=0
set timeout=5
serial --unit=0 --speed=115200
terminal_output console serial
search --no-floppy --file --set=root /boot/vmlinuz
if [ -z "\$root" ]; then search --no-floppy --label BOOT --set=root; fi
menuentry "Linux (custom, tvbox) - PERMANENTE" {
    linux  /boot/vmlinuz linuxmode=live persist=auto linuxmedia=UUID=$UUID loglevel=3 quiet console=tty0 console=ttyS0,115200
    initrd /boot/initrd.img
}
menuentry "Linux (custom, tvbox) - RAM (sem gravar)" {
    linux  /boot/vmlinuz linuxmode=live persist=none linuxmedia=UUID=$UUID loglevel=3 quiet console=tty0
    initrd /boot/initrd.img
}
EOF

if [ ! -f "$MNT/linux/persist.ext4" ]; then
    echo ">> criando persist.ext4 (3900 MB)"
    dd if=/dev/zero of="$MNT/linux/persist.ext4" bs=1M count=3900 status=none
    mkfs.ext2 -F -L PERSIST "$MNT/linux/persist.ext4" >/dev/null
fi

sync
umount "$MNT"
echo ">> INSTALACAO CONCLUIDA. Reinicie a maquina."
