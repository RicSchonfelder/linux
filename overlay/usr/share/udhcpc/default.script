#!/bin/sh
# script padrao do udhcpc (busybox)
RESOLV_CONF="/etc/resolv.conf"
[ -n "$1" ] || exit 0
case "$1" in
  deconfig)
    ifconfig "$interface" 0.0.0.0 2>/dev/null
    ;;
  renew|bound)
    ifconfig "$interface" "$ip" netmask "$subnet"
    if [ -n "$router" ]; then
      route del default gw 0.0.0.0 dev "$interface" 2>/dev/null
      for r in $router; do route add default gw "$r" dev "$interface"; done
    fi
    if [ -n "$dns" ]; then
      : > "$RESOLV_CONF"
      for d in $dns; do echo "nameserver $d" >> "$RESOLV_CONF"; done
    else
      echo "nameserver 1.1.1.1" > "$RESOLV_CONF"
    fi
    ;;
esac
exit 0
