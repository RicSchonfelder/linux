#!/bin/busybox sh
# rcS - inicializacao do sistema
/bin/busybox mkdir -p /proc /sys /dev /run /tmp /dev/pts
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /run 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /tmp 2>/dev/null
/bin/busybox hostname -F /etc/hostname 2>/dev/null || /bin/busybox hostname linux
[ -f /etc/sysctl.conf ] && /bin/busybox sysctl -p /etc/sysctl.conf 2>/dev/null

/etc/init.d/network start
/etc/init.d/dropbear start

# console serial (se existir)
if [ -c /dev/ttyS0 ]; then
    /sbin/getty -L 115200 ttyS0 vt100 >/dev/null 2>&1 &
fi
